# BIRD-Interact-ADK Configuration
# Copy this to .env and fill in your values

# ── LLM ──
# Set the API key for your LLM provider (used by LiteLlm)
# See https://docs.litellm.ai/docs/providers for supported providers
ANTHROPIC_API_KEY=sk-ant-...        # for anthropic/claude-*
# OPENAI_API_KEY=sk-...             # for openai/gpt-*

# ── Models ──
# LiteLlm model format: provider/model-name
# Examples: anthropic/claude-sonnet-4-20250514, openai/gpt-4o, ollama_chat/llama3
SYSTEM_AGENT_MODEL=anthropic/claude-sonnet-4-20250514
# Keep the simulator on the same tier as the system agent. On a weaker model
# it answers clarification questions against the ground-truth SQL it is
# holding (observed: '10 miles' where gold uses >= 50, twice), which caps
# tasks for both arms. Changing this changes the benchmark's answers -
# re-baseline both arms after any change.
USER_SIM_MODEL=anthropic/claude-sonnet-4-20250514

# ── Token / cost accounting ──
# One JSONL row per LLM call (role, model, tokens, cache tokens, dollar cost),
# appended by all three services. The orchestrator aggregates each run's own
# time window into that run's results JSON under "llm_usage" and logs a summary.
# Empty disables it. Roles come from BIRD_LLM_ROLE, set per service in
# scripts/start_services.sh — restart the services after changing either.
LLM_USAGE_PATH=results/llm_usage.jsonl

# ── Prompt caching ──
# Anthropic prompt caching for the system agent. Not a protocol deviation: it
# marks the re-sent prefix (tools + instruction, then the conversation history)
# as reusable without changing a byte the agent sees. Measured on one task run
# both ways: $0.331 -> $0.131, same reward, same budget. Ignored for non-Claude
# models. Confirm it is working via cache_read_tokens in the run's llm_usage.
PROMPT_CACHING=true

# ── Dataset ──
# Options: "lite" (300 tasks, 18 DBs) or "full" (600 tasks, 26 DBs)
DATASET=lite

# ── PostgreSQL ──
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=root
PG_PASSWORD=123123

# ── Service Ports ──
SYSTEM_AGENT_PORT=6000
USER_SIM_PORT=6001
DB_ENV_PORT=6002

# ── Budget / Turns ──
# a-interact: budget = 6 + 2*ambiguities + 2*patience (per task)
# c-interact: max_turns = ambiguities + patience (per task)
PATIENCE=3

# ── Environment Backend ──
# Backend selection is a --backend CLI flag, not an .env setting:
#   scripts/start_services.sh --backend atscale
#   python -m orchestrator.runner --backend atscale ...
# "raw" (default): original Postgres tools, unchanged.
# A named backend from config/environment_backends.yaml (e.g. "atscale") routes
# exploration/query tools through that semantic layer's MCP server instead.
# The system_agent/db_environment services must be started with a matching
# --backend — orchestrator.runner checks this at startup and fails loudly on
# a mismatch, since it can't change an already-running service's backend.
SEMANTIC_LAYER_MCP_URL=https://mcp-aws.atscaleinternal.com/mcp
SEMANTIC_LAYER_MCP_TOKEN=

# ── Submit feedback ──
# What a failed submit_sql tells the agent.
#   none  (default) "Your SQL is not correct." and nothing else. Upstream
#         BIRD-Interact's protocol — the 3-coin charge IS the penalty for
#         guessing — and the only setting whose scores are comparable to
#         published BIRD-Interact numbers.
#   shape adds row/column counts and whether the rows match but the order
#         doesn't. Never a value, a column name or a row.
# Applies to BOTH backends (raw and semantic-layer); the level a run used is
# recorded in the results JSON.
SUBMIT_FEEDBACK_LEVEL=none

# Deviations from upstream BIRD-Interact's protocol. All default to upstream
# behaviour, so leaving them alone reproduces published numbers; turning any on
# makes a run non-comparable. Verified against the reference implementation
# (bird_interact_agent/, evaluation/) on 2026-08-04.
#
# Upstream compares ordered results with a bare `predicted_res == ground_res`.
# When gold's ORDER BY key has ties, the order inside a tied block is arbitrary
# and two engines legitimately disagree. true forgives a tie-only permutation.
GRADING_TIE_TOLERANCE=false
#
# Upstream never reads conditions["decimal"] — it always rounds to 2. true
# honours each task's declared precision, differing from upstream on the 125 of
# 600 tasks that declare `decimal >= 0 and != 2`. (-1 means "unspecified" and
# resolves to 2 either way, so it does not depend on this flag.)
GRADING_HONOR_DECIMAL=false
#
# Grade row order only where gold determines one. 68 of 438 order-sensitive
# phases carry `order: true` over a gold whose own ORDER BY leaves the order to
# the query plan; true compares those as multisets. The list is measured, not
# parsed — regenerate with
#   python scripts/bird_order_lint.py --write config/order_undetermined.json <all 22 dbs>
GRADING_ORDER_LINT=false
#
# Retry a failed comparison on the pre-rounding rows with a relative tolerance,
# for gold SQL that computes in float32 (`::real`) where every other engine
# uses float64. Can only turn a 0 into a 1. Keep the value below the precision
# tasks are graded to — see shared/config.py before changing it.
GRADING_REL_TOLERANCE=false
GRADING_REL_TOLERANCE_VALUE=1e-6
#
# Case-fold string cells on the cross-source (semantic-layer) path, where gold's
# invisible LOWER(...) meets a semantic layer's stored display casing.
GRADING_CASEFOLD=false
#
# Truncate a timestamp STRING to its date on that same cross-source path. The one
# flag here that defaults to ON, because it removes an asymmetry rather than
# adding a tolerance: preprocess_results already truncates a TYPED date, so gold
# arrives as '2025-02-19' while the semantic layer returns '2025-02-19 16:29:00'
# and can never match it. Its cost, since both sides are truncated: gold text
# that merely looks like a timestamp compares equal at date granularity. Measured
# 2026-08-18 over the recorded grading audit — 0 of 4 affected submissions change
# verdict either way, so nothing recorded so far depends on it.
GRADING_TIMESTAMP_DATE=true
#
# Records each graded submission (rows, gold SQL, verdict, timestamp) so a
# grading change can be re-scored offline (scripts/score_dual.py) instead of by
# spending a re-run. Grading itself is unaffected. Empty disables it.
GRADING_AUDIT_PATH=results/grading_audit.jsonl
#
# a-interact only. Upstream charges by action TYPE and never inspects the
# outcome, so a duplicate submit and a bundled question both cost full price.
# true refuses those two at no charge instead.
FREE_WASTED_ACTIONS=false

# Semantic-layer backends only; not a grading flag — it changes what the arm can
# DO, so an on/off pair is not comparable and the value is recorded per run.
# The raw backend has always had three tools over the task's external_knowledge
# (the benchmark's glossary of domain terms); the semantic-layer backends have
# none, because tools_atscale.py maps get_all_knowledge_definitions to
# get_sml_skills, which returns query-construction guidance rather than
# definitions. true gives them the same three tools at the same prices. Masked
# entries are withheld under both settings (db_environment/server.py's
# _filter_knowledge), so the entries the agent is meant to ask the user about
# stay hidden. Whether this SHOULD be on is a scope question — see tracker B-12.
SEMANTIC_LAYER_KNOWLEDGE_TOOLS=false

# Completion-token ceiling per system-agent LLM call (both arms; symmetric).
# Too low truncates extended-thinking turns into empty final answers - the task
# then ends unsubmitted with budget left. 16384 default; 4096 was the old
# hardcoded value that caused those deaths.
SYSTEM_AGENT_MAX_TOKENS=16384

# Completion budget for the user simulator's two LLM stages. Sonnet-class
# models spend tokens thinking (native blocks + the v2 prompts' <think>
# protocol) before the <s>answer</s>; too small truncates mid-think and the
# agent receives an empty answer that still costs 2 bird-coins.
USER_SIM_MAX_TOKENS=8192
